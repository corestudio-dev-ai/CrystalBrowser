<Window x:Class="CrystalBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crystal Browser" Height="700" Width="1024" MinHeight="420" MinWidth="640"
        Background="#0e0d1c" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <!-- Window caption button (minimize / maximize / close) -->
        <Style TargetType="Button" x:Key="CaptionBtn">
            <Setter Property="Foreground" Value="#cfceeb"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2a2845"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="CloseBtn" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#e81123"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Icon / nav button -->
        <Style TargetType="Button" x:Key="IconBtn">
            <Setter Property="Foreground" Value="#cfceeb"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2a2845"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4a4866"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab item with title + close affordance -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#b9b7da"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="root" Margin="2,4,2,0" CornerRadius="10,10,0,0"
                                Background="Transparent" Padding="0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1b1933"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#171530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="TabClose" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9a98c0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootPadding">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- tab strip -->
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- bookmarks bar -->
            <RowDefinition Height="Auto"/>  <!-- update banner -->
            <RowDefinition Height="Auto"/>  <!-- default-browser nag -->
            <RowDefinition Height="*"/>      <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Title bar: logo + tabs (left), drag area, window controls (right) -->
        <Grid Grid.Row="0" Background="#0e0d1c">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&#128142;" FontSize="15" VerticalAlignment="Center"
                       Margin="12,0,6,0" Foreground="#b39bff"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl x:Name="TabHeaders" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Style="{StaticResource IconBtn}" Content="＋" VerticalAlignment="Bottom"
                        Margin="2,0,0,4" Click="BtnNewTab_Click" ToolTip="New tab"/>
            </StackPanel>

            <!-- Column 2 is draggable caption space; holds the private-mode badge -->
            <Border x:Name="PrivateBadge" Grid.Column="2" Visibility="Collapsed"
                    Background="#3a2d6e" CornerRadius="11" Padding="10,2" Margin="10,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="&#128737; Private · Tor" Foreground="#cdbcff" FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Content="&#xE921;"
                        Click="BtnMin_Click" ToolTip="Minimize"/>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Content="&#xE922;"
                        Click="BtnMax_Click" ToolTip="Maximize"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                        Click="BtnClose_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#1b1933" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Content="&#9664;" Click="BtnBack_Click" ToolTip="Back"/>
                    <Button x:Name="BtnForward" Style="{StaticResource IconBtn}" Content="&#9654;" Click="BtnForward_Click" ToolTip="Forward"/>
                    <Button x:Name="BtnReload" Style="{StaticResource IconBtn}" Content="&#10227;" Click="BtnReload_Click" ToolTip="Reload"/>
                    <Button x:Name="BtnHome" Style="{StaticResource IconBtn}" Content="&#8962;" Click="BtnHome_Click" ToolTip="Home"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#0f0e22" CornerRadius="18" Margin="8,0" Padding="16,0"
                        BorderBrush="#2c2a4d" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#128269;" Foreground="#6f6da0"
                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                        <TextBox x:Name="AddressBar" Grid.Column="1" VerticalAlignment="Center" Height="34"
                                 Background="Transparent" Foreground="#f0efff" BorderThickness="0"
                                 FontSize="14" CaretBrush="#7c6cff" VerticalContentAlignment="Center"
                                 KeyDown="AddressBar_KeyDown"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnEdit" Click="BtnEdit_Click" Cursor="Hand"
                                  Foreground="#cfceeb" BorderThickness="0" Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="eb" CornerRadius="8" Padding="12,7" Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#9998;" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Edit" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="eb" Property="Background" Value="#2a2845"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="eb" Property="Background" Value="#7c6cff"/>
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button x:Name="BtnStar" Style="{StaticResource IconBtn}" Content="&#9734;"
                            Click="BtnStar_Click" ToolTip="Bookmark this page" Margin="2,0,0,0"/>
                    <Button x:Name="BtnPrivate" Style="{StaticResource IconBtn}" Content="&#128737;"
                            Click="BtnPrivate_Click" ToolTip="New private window (Tor)" Margin="2,0,0,0"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}" Content="&#9881;"
                            Click="BtnSettings_Click" ToolTip="Settings &amp; About" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bookmarks bar (hidden when empty) -->
        <Border x:Name="BookmarkBar" Grid.Row="2" Background="#15132a" Padding="6,3"
                BorderBrush="#262445" BorderThickness="0,1,0,1" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BookmarkStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Update banner (shown only when a new version is available) -->
        <Border x:Name="UpdateBar" Grid.Row="3" Visibility="Collapsed" Padding="14,8"
                Background="#2e2563" BorderBrush="#4a3da0" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#11014;" FontSize="14" Foreground="#cdbcff"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="UpdateText" Grid.Column="1" Foreground="#ece9ff" FontSize="13"
                           VerticalAlignment="Center" Text="A new version of Crystal Browser is available."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnUpdateNow" Content="Update now" Click="BtnUpdateNow_Click"
                            Foreground="#ffffff" Background="#7c6cff" BorderThickness="0" Cursor="Hand"
                            Padding="14,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnUpdateLater" Content="Later" Click="BtnUpdateLater_Click"
                            Style="{StaticResource IconBtn}" Width="60"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Default-browser nag (Chrome-style; shown until set as default or dismissed) -->
        <Border x:Name="DefaultBar" Grid.Row="4" Visibility="Collapsed" Padding="14,8"
                Background="#1f2d4d" BorderBrush="#34529a" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#128142;" FontSize="14" Foreground="#a9c5ff"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Foreground="#eaf1ff" FontSize="13" VerticalAlignment="Center"
                           Text="Make Crystal Browser your default browser."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnSetDefault" Content="Set as default" Click="BtnSetDefault_Click"
                            Foreground="#ffffff" Background="#3a6bd6" BorderThickness="0" Cursor="Hand"
                            Padding="14,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNoThanks" Content="No thanks" Click="BtnNoThanks_Click"
                            Style="{StaticResource IconBtn}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content host (single WebView swapped per active tab) -->
        <Grid x:Name="BrowserHost" Grid.Row="5" Background="#0e0d1c"/>

        <!-- Status bar with live system monitor -->
        <Border Grid.Row="6" Background="#13122a" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#7e7ba6"
                           FontSize="11" VerticalAlignment="Center" Text="Ready"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CPU" Foreground="#6f6da0" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border Width="60" Height="6" Background="#262445" CornerRadius="3" VerticalAlignment="Center">
                        <Border x:Name="CpuBar" HorizontalAlignment="Left" Width="0" Background="#7c6cff" CornerRadius="3"/>
                    </Border>
                    <TextBlock x:Name="CpuText" Foreground="#cfceeb" FontSize="11" Width="34"
                               TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,16,0" Text="0%"/>

                    <TextBlock Text="RAM" Foreground="#6f6da0" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border Width="60" Height="6" Background="#262445" CornerRadius="3" VerticalAlignment="Center">
                        <Border x:Name="RamBar" HorizontalAlignment="Left" Width="0" Background="#b39bff" CornerRadius="3"/>
                    </Border>
                    <TextBlock x:Name="RamText" Foreground="#cfceeb" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0" Text="0%"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
