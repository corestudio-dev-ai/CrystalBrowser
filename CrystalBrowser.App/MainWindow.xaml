<Window x:Class="CrystalBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crystal Browser" Height="700" Width="1024" MinHeight="420" MinWidth="640"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <!-- GlassFrameThickness="0": do NOT extend the DWM glass frame into the window.
             A non-zero glass frame makes Windows 11 paint its own (native) caption
             buttons in the top-right, which doubled up with our custom ones. Mica still
             renders via the DWMWA_SYSTEMBACKDROP_TYPE call in Window_SourceInitialized. -->
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <!-- Accent colour (themed live from Settings). Oceanic blue (1.8.1 liquid-glass). -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1E88E5"/>
        <!-- Window frame border colour (user-changeable via Settings). -->
        <SolidColorBrush x:Key="FrameBrush" Color="#1E88E5"/>

        <!-- Theme surfaces (dark defaults; swapped live by ApplyTheme).
             Slight alpha lets the Win11 Mica backdrop show through the chrome. -->
        <SolidColorBrush x:Key="WindowBg" Color="#0d1018"/>
        <SolidColorBrush x:Key="ChromeBg" Color="#161a24"/>
        <SolidColorBrush x:Key="ChromeBg2" Color="#11141d"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#1a1e2a"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#eef1f8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8b90a3"/>
        <SolidColorBrush x:Key="TabTextActive" Color="#ffffff"/>
        <SolidColorBrush x:Key="TabTextInactive" Color="#b3b8c7"/>
        <SolidColorBrush x:Key="TabActiveBg" Color="#222735"/>

        <!-- Window caption buttons (minimize / maximize / close) — flat, restrained (1.7).
             The glyphs are drawn as vector geometry inside the template (not icon-font
             text), with the stroke driven by TemplateBinding Foreground so hover states
             work. Vector shapes anti-alias in grayscale, so there is no ClearType colour
             fringing on the transparent Mica backdrop. -->
        <Style TargetType="Button" x:Key="CaptionBtnBase">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#c3c7d6"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <!-- Minimize: a single horizontal line. -->
        <Style TargetType="Button" x:Key="MinBtn" BasedOn="{StaticResource CaptionBtnBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Margin="2,4">
                            <Path Data="M0,0 H10" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Maximize: a square outline. -->
        <Style TargetType="Button" x:Key="MaxBtn" BasedOn="{StaticResource CaptionBtnBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Margin="2,4">
                            <Path Data="M0,0 H10 V10 H0 Z" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close (exit): an X. Neutral until hovered, then black with a white glyph (1.8 Zen). -->
        <Style TargetType="Button" x:Key="CloseBtn" BasedOn="{StaticResource CaptionBtnBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Margin="2,4">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#000000"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Icon / nav button -->
        <Style TargetType="Button" x:Key="IconBtn">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2a221b"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4a4866"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab item with title + close affordance -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#b9b7da"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="root" Margin="2,4,2,0" CornerRadius="10,10,0,0"
                                Background="Transparent" Padding="0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1b1933"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#171530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="TabClose" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9a98c0"/>
        </Style>

        <!-- Rounded "chip" used by the AI companion switcher (Gemini / Claude / ChatGPT). -->
        <ControlTemplate x:Key="AiChipTemplate" TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Window frame: a thin, solid, user-colourable border (1.7 redesign — no neon).
         Background is transparent so the Win11 Mica backdrop shows through bare chrome areas. -->
    <Border x:Name="FrameBorder" BorderThickness="1" Background="Transparent"
            BorderBrush="{DynamicResource FrameBrush}">
    <Grid x:Name="RootPadding">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- tab strip -->
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- bookmarks bar -->
            <RowDefinition Height="Auto"/>  <!-- unsupported-version nag -->
            <RowDefinition Height="Auto"/>  <!-- update banner -->
            <RowDefinition Height="Auto"/>  <!-- default-browser nag -->
            <RowDefinition Height="Auto"/>  <!-- private loading bar -->
            <RowDefinition Height="Auto"/>  <!-- save-password (autofill) bar -->
            <RowDefinition Height="*"/>      <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Title bar: logo + tabs (left), drag area, window controls (right) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="12,0,8,0">
                <Path Data="M5,3 H19 L22,9 L12,21 L2,9 Z" Stretch="Uniform" Width="15" Height="15"
                      Stroke="#FF3B30" StrokeThickness="1.4" StrokeLineJoin="Round"
                      Fill="#40FF3B30" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Crystal" FontSize="13" FontWeight="SemiBold" Foreground="#e9e9ff"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Horizontal tab strip (default layout) -->
            <StackPanel x:Name="HorizontalTabBar" Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel x:Name="HorizontalTabStrip" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                <Button Style="{StaticResource IconBtn}" Content="＋" VerticalAlignment="Bottom"
                        Margin="2,0,0,4" Click="BtnNewTab_Click" ToolTip="New tab"/>
            </StackPanel>

            <!-- Column 2 is draggable caption space; holds the incognito-mode badge -->
            <Border x:Name="PrivateBadge" Grid.Column="2" Visibility="Collapsed"
                    Background="#3a2d6e" CornerRadius="11" Padding="10,2" Margin="10,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="#cdbcff" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Incognito" Foreground="#cdbcff" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <!-- Vector glyphs drawn inside each button's template (see styles above). -->
                <Button x:Name="BtnMin" Style="{StaticResource MinBtn}"
                        Click="BtnMin_Click" ToolTip="Minimize"/>
                <Button x:Name="BtnMax" Style="{StaticResource MaxBtn}"
                        Click="BtnMax_Click" ToolTip="Maximize"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}"
                        Click="BtnClose_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ChromeBg}" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Content="&#9664;" Click="BtnBack_Click" ToolTip="Back"/>
                    <Button x:Name="BtnForward" Style="{StaticResource IconBtn}" Content="&#9654;" Click="BtnForward_Click" ToolTip="Forward"/>
                    <Button x:Name="BtnReload" Style="{StaticResource IconBtn}" Content="&#10227;" Click="BtnReload_Click" ToolTip="Reload"/>
                    <Button x:Name="BtnHome" Style="{StaticResource IconBtn}" Content="&#8962;" Click="BtnHome_Click" ToolTip="Home"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBg}" CornerRadius="18" Margin="8,0" Padding="16,0"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#6f6da0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                        <TextBox x:Name="AddressBar" Grid.Column="1" VerticalAlignment="Center" Height="34"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                                 FontSize="14" CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                                 KeyDown="AddressBar_KeyDown"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnEdit" Click="BtnEdit_Click" Cursor="Hand"
                                  Foreground="#cfceeb" BorderThickness="0" Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="eb" CornerRadius="8" Padding="12,7" Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#9998;" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Edit" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="eb" Property="Background" Value="#2a221b"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="eb" Property="Background" Value="#FF7A1A"/>
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button x:Name="BtnShot" Style="{StaticResource IconBtn}" Content="&#xE722;"
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Click="BtnShot_Click" ToolTip="Screenshot this page (saves to Documents\Crystal Browser Screens)"
                            Margin="2,0,0,0"/>
                    <Button x:Name="BtnStar" Style="{StaticResource IconBtn}" Content="&#9734;"
                            Click="BtnStar_Click" ToolTip="Bookmark this page" Margin="2,0,0,0"/>
                    <Button x:Name="BtnPrivate" Style="{StaticResource IconBtn}" Content="&#xE7B3;"
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Click="BtnPrivate_Click" ToolTip="New Incognito window" Margin="2,0,0,0"/>
                    <Button x:Name="BtnAi" Style="{StaticResource IconBtn}" Content="AI" FontSize="12" FontWeight="SemiBold"
                            Click="BtnAi_Click" ToolTip="AI companion sidebar" Margin="2,0,0,0"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}" Content="&#9881;"
                            Click="BtnSettings_Click" ToolTip="Settings &amp; About" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bookmarks bar (hidden when empty) -->
        <Border x:Name="BookmarkBar" Grid.Row="2" Background="{DynamicResource ChromeBg2}" Padding="10,6"
                BorderThickness="0" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BookmarkStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Unsupported-version nag: shown every launch when the running build is
             end-of-life (see SupportPolicy). It nags but never blocks — the browser
             stays fully usable, and "Later" only hides it for this session. -->
        <Border x:Name="UnsupportedBar" Grid.Row="3" Visibility="Collapsed" Padding="14,8"
                Background="#4a2730" BorderBrush="#8a3b48" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#ffb3bf" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="UnsupportedText" Grid.Column="1" Foreground="#ffe6ea" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="This version of Crystal Browser is no longer supported. You can keep using it, but please update to the latest version."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnUnsupportedUpdate" Content="Update now" Click="BtnUnsupportedUpdate_Click"
                            Foreground="#ffffff" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                            Padding="14,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnUnsupportedLater" Content="Later" Click="BtnUnsupportedLater_Click"
                            Style="{StaticResource IconBtn}" Width="60"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner (shown only when a new version is available) -->
        <Border x:Name="UpdateBar" Grid.Row="4" Visibility="Collapsed" Padding="14,8"
                Background="#2e2563" BorderBrush="#4a3da0" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#cdbcff" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="UpdateText" Grid.Column="1" Foreground="#ece9ff" FontSize="13"
                           VerticalAlignment="Center" Text="A new version of Crystal Browser is available."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnUpdateNow" Content="Update now" Click="BtnUpdateNow_Click"
                            Foreground="#ffffff" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                            Padding="14,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnUpdateLater" Content="Later" Click="BtnUpdateLater_Click"
                            Style="{StaticResource IconBtn}" Width="60"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Default-browser nag (Chrome-style; shown until set as default or dismissed) -->
        <Border x:Name="DefaultBar" Grid.Row="5" Visibility="Collapsed" Padding="14,8"
                Background="#1f2d4d" BorderBrush="#34529a" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#a9c5ff" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Foreground="#eaf1ff" FontSize="13" VerticalAlignment="Center"
                           Text="Make Crystal Browser your default browser."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnSetDefault" Content="Set as default" Click="BtnSetDefault_Click"
                            Foreground="#ffffff" Background="#3a6bd6" BorderThickness="0" Cursor="Hand"
                            Padding="14,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNoThanks" Content="No thanks" Click="BtnNoThanks_Click"
                            Style="{StaticResource IconBtn}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Private-window loading bar with live percentage. WebView2 is a windowed control
             that paints over WPF, so this lives in its own row rather than overlaying the page. -->
        <Border x:Name="LoadBar" Grid.Row="6" Visibility="Collapsed" Background="#15132a"
                BorderBrush="#2e2563" BorderThickness="0,0,0,1" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#128737; Loading…" Foreground="#cdbcff"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border x:Name="LoadTrack" Grid.Column="1" Height="6" Background="#262445"
                        CornerRadius="3" VerticalAlignment="Center">
                    <Border x:Name="LoadFill" HorizontalAlignment="Left" Width="0"
                            Background="#FF7A1A" CornerRadius="3"/>
                </Border>
                <TextBlock x:Name="LoadPct" Grid.Column="2" Text="0%" Foreground="#ece9ff"
                           FontSize="12" Width="42" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Save-password bar (Crystal autofill): offered after a login form is submitted. -->
        <Border x:Name="SaveLoginBar" Grid.Row="7" Visibility="Collapsed" Padding="14,8"
                Background="#2a1c10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SaveLoginText" Grid.Column="1" Foreground="#ffeede" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Save this password?"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnSaveLogin" Content="Save" Click="BtnSaveLogin_Click"
                            Foreground="#ffffff" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                            Padding="16,5" FontSize="13" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSaveLoginDismiss" Content="Not now" Click="BtnSaveLoginDismiss_Click"
                            Style="{StaticResource IconBtn}" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: vertical tab sidebar (left), web content (centre), AI companion (right) -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical tab rail. -->
            <Border x:Name="TabSidebar" Grid.Column="0" Width="172" Background="{DynamicResource ChromeBg2}"
                    BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Grid ClipToBounds="True">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource IconBtn}" Content="＋  New tab"
                                Width="Auto" Height="36" HorizontalContentAlignment="Left"
                                Padding="12,0" Margin="8,8,8,4" Foreground="#cfceeb"
                                Click="BtnNewTab_Click" ToolTip="New tab"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="6,2">
                            <StackPanel x:Name="VerticalTabStrip" Orientation="Vertical"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Content host (single WebView swapped per active tab) -->
            <Grid x:Name="BrowserHost" Grid.Column="1" Background="{DynamicResource WindowBg}"/>

            <!-- AI companion sidebar (Gemini / Claude / ChatGPT), like Edge Copilot. Hidden by
                 default; its own WebView2 is created lazily the first time it's opened. -->
            <Border x:Name="AiSidebar" Grid.Column="2" Width="392" Visibility="Collapsed"
                    Background="{DynamicResource ChromeBg2}" BorderBrush="#262445" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="AiPicker" Grid.Column="0" Orientation="Horizontal"/>
                            <Button x:Name="BtnAiClose" Grid.Column="1" Style="{StaticResource IconBtn}"
                                    Content="&#10005;" Click="BtnAiClose_Click" ToolTip="Close sidebar"/>
                        </Grid>
                    </Border>
                    <Grid x:Name="AiHost" Background="{DynamicResource WindowBg}">
                        <!-- Shown instead of the web view when Claude is selected but the user
                             isn't signed in to claude.ai yet (WebView2 paints over WPF, so we
                             collapse the view rather than overlay this). -->
                        <Border x:Name="AiNotice" Visibility="Collapsed" Padding="28"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sign in to use Claude" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"
                                           Text="Claude needs you to sign in first. Open claude.ai in a tab and sign in with your Claude account — then Claude becomes available here in the sidebar."/>
                                <Button x:Name="BtnOpenClaude" Content="Open claude.ai to sign in"
                                        Click="BtnOpenClaude_Click" Cursor="Hand" Foreground="#ffffff"
                                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                                        Padding="16,9" FontSize="13" Margin="0,18,0,0"/>
                                <Button x:Name="BtnRecheckClaude" Content="I've signed in — try again"
                                        Click="BtnRecheckClaude_Click" Style="{StaticResource IconBtn}"
                                        Width="Auto" Height="Auto" Padding="12,7" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar with live system monitor -->
        <Border Grid.Row="9" Background="{DynamicResource ChromeBg2}" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" Text="Ready"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CPU" Foreground="#6f6da0" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border Width="60" Height="6" Background="#262445" CornerRadius="3" VerticalAlignment="Center">
                        <Border x:Name="CpuBar" HorizontalAlignment="Left" Width="0" Background="#FF7A1A" CornerRadius="3"/>
                    </Border>
                    <TextBlock x:Name="CpuText" Foreground="#cfceeb" FontSize="11" Width="34"
                               TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,16,0" Text="0%"/>

                    <TextBlock Text="RAM" Foreground="#6f6da0" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border Width="60" Height="6" Background="#262445" CornerRadius="3" VerticalAlignment="Center">
                        <Border x:Name="RamBar" HorizontalAlignment="Left" Width="0" Background="#FFA85C" CornerRadius="3"/>
                    </Border>
                    <TextBlock x:Name="RamText" Foreground="#cfceeb" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0" Text="0%"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
